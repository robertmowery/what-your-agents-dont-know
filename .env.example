# Copy to .env and set your own Google Cloud project. No secrets belong here:
# authentication uses Application Default Credentials (gcloud auth application-default login).
GOOGLE_CLOUD_PROJECT=your-project-id
GOOGLE_CLOUD_QUOTA_PROJECT=your-project-id

# Gemini through Vertex AI, used by the ADK agent.
GOOGLE_GENAI_USE_ENTERPRISE=TRUE
GOOGLE_CLOUD_LOCATION=global

# Claude, used by the Claude Agent SDK agent. Two routes:
#   anthropic (default): Anthropic's API. Never put the key in this file. Either
#     export ANTHROPIC_API_KEY in your shell, or on macOS store it in the Keychain
#     (security add-generic-password -a "$USER" -s anthropic-api-key -U -w)
#     and name the item here.
#   vertex: Claude through Vertex AI in your project, no key. Enable the Claude
#     models in Model Garden and make sure the project has Claude quota.
CLAUDE_ROUTE=anthropic
ANTHROPIC_KEYCHAIN_SERVICE=anthropic-api-key
CLAUDE_VERTEX_REGION=global

# The BigQuery dataset Terraform creates and the load script fills.
BQ_DATASET=tessaway_wh
BQ_LOCATION=US

# The BigQuery dataset Terraform creates for the semantic layer's views (Part 2).
BQ_SEMANTIC_DATASET=tessaway_sem
