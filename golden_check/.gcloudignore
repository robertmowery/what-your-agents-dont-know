# What `gcloud builds submit --ignore-file golden_check/.gcloudignore` uploads for the
# golden-set check's image: only what the Dockerfile copies. .env and Terraform state stay home.
/*
!/requirements.txt
!/tessaway/
!/context_server/
!/golden_check/
!/questions/
!/run_part1.py
!/run_part2.py
!/run_part3.py
!/run_part4.py
!/data/
/data/*
!/data/DEFINITIONS.md
!/data/definition_registry.json
!/results/
/results/*
!/results/part1/
/results/part1/*
!/results/part1/gold_answers.json
!/results/part5/
/results/part5/*
!/results/part5/alert_baseline.json
__pycache__/
*.pyc
.env
.env.*
