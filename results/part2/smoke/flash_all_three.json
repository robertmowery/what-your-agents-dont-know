     "generated_sql": "-- Combine Aggregated Outputs\n-- Order By [] Limit 51\n-- Write to DataTable\nSELECT\n  MAX(subq_7.operations_on_time_rate) AS operations_on_time_rate\n  , MAX(subq_15.portal_on_time_rate) AS portal_on_time_rate\nFROM (\n  -- Compute Metrics via Expressions\n  SELECT\n    100 * on_time_loads / nullif(delivered_loads, 0) AS operations_on_time_rate\n  FROM (\n    -- Read Elements From Semantic Model 'deliveries'\n    -- Metric Time Dimension 'delivered_date'\n    -- Constrain Time Range to [2026-09-01T00:00:00, 2026-09-30T00:00:00]\n    -- Select: ['__on_time_loads', '__delivered_loads']\n    -- Select: ['__on_time_loads', '__delivered_loads']\n    -- Aggregate Inputs for Simple Metrics\n    -- Compute Metrics via Expressions\n    SELECT\n      SUM(case when arrived_on_time then 1 else 0 end) AS on_time_loads\n      , SUM(1) AS delivered_loads\n    FROM `PROJECT`.`tessaway_sem`.`deliveries` deliveries_src_10000\n    WHERE TIMESTAMP_TRUNC(delivered_date, day) BETWEEN '2026-09-01' AND '2026-09-30'\n  ) subq_6\n) subq_7\nCROSS JOIN (\n  -- Compute Metrics via Expressions\n  SELECT\n    100 * portal_on_time_shipments / nullif(portal_shipments, 0) AS portal_on_time_rate\n  FROM (\n    -- Read Elements From Semantic Model 'portal_shipments'\n    -- Metric Time Dimension 'portal_delivered_date'\n    -- Constrain Time Range to [2026-09-01T00:00:00, 2026-09-30T00:00:00]\n    -- Select: ['__portal_on_time_shipments', '__portal_shipments']\n    -- Select: ['__portal_on_time_shipments', '__portal_shipments']\n    -- Aggregate Inputs for Simple Metrics\n    -- Compute Metrics via Expressions\n    SELECT\n      SUM(case when portal_on_time then 1 else 0 end) AS portal_on_time_shipments\n      , SUM(1) AS portal_shipments\n    FROM `PROJECT`.`tessaway_sem`.`portal_shipments` portal_shipments_src_10000\n    WHERE TIMESTAMP_TRUNC(portal_delivered_date, day) BETWEEN '2026-09-01' AND '2026-09-30'\n  ) subq_14\n) subq_15\nLIMIT 51",
