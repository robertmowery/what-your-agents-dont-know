      "order_by": [],
      "limit": 50
     },
     "generated_sql": "-- Combine Aggregated Outputs\n-- Order By [] Limit 51\n-- Write to DataTable\nWITH sma_10001_cte AS (\n  -- Read Elements From Semantic Model 'deliveries'\n  -- Metric Time Dimension 'delivered_date'\n  SELECT\n    TIMESTAMP_TRUNC(delivered_date, day) AS metric_time__day\n    , 1 AS __delivered_loads\n    , case when arrived_on_time then 1 else 0 end AS __on_time_loads\n    , case when arrived_on_time or not shipper_delayed then 1 else 0 end AS __on_time_measured_loads\n  FROM `PROJECT`.`tessaway_sem`.`deliveries` deliveries_src_10000\n)\n\nSELECT\n  MAX(subq_7.on_time_rate) AS on_time_rate\n  , MAX(subq_13.on_time_loads) AS on_time_loads\n  , MAX(subq_13.on_time_measured_loads) AS on_time_measured_loads\n  , MAX(subq_13.delivered_loads) AS delivered_loads\nFROM (\n  -- Compute Metrics via Expressions\n  SELECT\n    100 * on_time_loads / nullif(on_time_measured_loads, 0) AS on_time_rate\n  FROM (\n    -- Read From CTE For node_id=sma_10001\n    -- Constrain Time Range to [2026-09-01T00:00:00, 2026-09-30T00:00:00]\n    -- Select: ['__on_time_loads', '__on_time_measured_loads']\n    -- Select: ['__on_time_loads', '__on_time_measured_loads']\n    -- Aggregate Inputs for Simple Metrics\n    -- Compute Metrics via Expressions\n    SELECT\n      SUM(__on_time_loads) AS on_time_loads\n      , SUM(__on_time_measured_loads) AS on_time_measured_loads\n    FROM sma_10001_cte\n    WHERE metric_time__day BETWEEN '2026-09-01' AND '2026-09-30'\n  ) subq_6\n) subq_7\nCROSS JOIN (\n  -- Read From CTE For node_id=sma_10001\n  -- Constrain Time Range to [2026-09-01T00:00:00, 2026-09-30T00:00:00]\n  -- Select: ['__on_time_loads', '__on_time_measured_loads', '__delivered_loads']\n  -- Select: ['__on_time_loads', '__on_time_measured_loads', '__delivered_loads']\n  -- Aggregate Inputs for Simple Metrics\n  -- Compute Metrics via Expressions\n  SELECT\n    SUM(__on_time_loads) AS on_time_loads\n    , SUM(__on_time_measured_loads) AS on_time_measured_loads\n    , SUM(__delivered_loads) AS delivered_loads\n  FROM sma_10001_cte\n  WHERE metric_time__day BETWEEN '2026-09-01' AND '2026-09-30'\n) subq_13\nLIMIT 51",
